<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for release builds (release.sh).
  - audio-input:   voice dictation and meeting capture (the mic TCC prompt still applies).
  - apple-events:  in-process NSAppleScript (front browser URL for screen context,
                   quick capture, meeting app detection).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
