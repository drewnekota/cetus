{
  // Cetus Remote relay: pairs a Mac (role=server) with phones (role=client)
  // by server id and forwards opaque, end-to-end encrypted frames.
  "name": "cetus-relay",
  "account_id": "b975c9806857f9f5024bfcbd3a373fbf",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "relay.cetus.run", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
